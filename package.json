{
  "name": "dsh-subtopic",
  "version": "0.1.0",
  "description": "Select text in a DSH conversation and press Ctrl to open a floating sub-topic card that explains the selection, with a follow-up tree, drag-to-quote chips and a settings page for the hotkey and colour.",
  "license": "MIT",
  "type": "module",
  "main": "lib/host.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcx3915-pixel/dsh-subtopic.git"
  },
  "homepage": "https://github.com/jcx3915-pixel/dsh-subtopic#readme",
  "bugs": {
    "url": "https://github.com/jcx3915-pixel/dsh-subtopic/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "test": "node test/client-smoke.mjs && node test/client-flow.mjs && node test/host-half.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subtopic",
    "selection",
    "explain",
    "追问",
    "子话题"
  ],
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
